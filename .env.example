# Reference values. Set them in the process environment (see docs/environment.md).
RESEARCH_OLLAMA_URL=http://localhost:11434
RESEARCH_OLLAMA_MODEL=qwen3.5:4b
RESEARCH_OLLAMA_TIMEOUT=90
RESEARCH_OLLAMA_CONTEXT=4096
RESEARCH_OLLAMA_MAX_OUTPUT=512
# Embedding endpoint defaults to RESEARCH_OLLAMA_URL.
# RESEARCH_EMBED_URL=http://127.0.0.1:11435
RESEARCH_EMBED_MODEL=embeddinggemma
# Required when using research --online; use your app's public operator contact.
# RESEARCH_WIKI_CONTACT=https://your-project.example/contact
# RESEARCH_APP_DIR=.research-agent/app
# RESEARCH_API_URL=http://127.0.0.1:8000
